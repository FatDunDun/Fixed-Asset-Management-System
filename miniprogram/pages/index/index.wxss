/* pages/index/index.wxss */

.header-banner {
  background: #FFFFFF;
  border-radius: 0 0 48rpx 48rpx;
  padding: 48rpx 36rpx 120rpx 36rpx;
  margin: -32rpx -32rpx 0 -32rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.04);
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  position: relative;
  z-index: 1;
}

.user-profile {
  align-items: center;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border-radius: 50%;
  margin-right: 28rpx;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.2);
}

.avatar-letter {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
}

.welcome-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 1rpx;
}

.role-badge-row {
  margin-top: 16rpx;
}

.role-badge-row .badge {
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
}

.live-indicator {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.dot-blink {
  width: 14rpx;
  height: 14rpx;
  background-color: #34D399; /* Green dot */
  border-radius: 50%;
  margin-right: 12rpx;
  box-shadow: 0 0 12rpx #34D399;
  animation: blink 2s infinite ease-in-out;
}

@keyframes blink {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}

/* Metrics Grid 2x2 layout */
.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: -60rpx;
  margin-bottom: 32rpx;
  z-index: 2;
}

.metric-card {
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
  position: relative;
  overflow: hidden;
}

.bg-purple {
  background: linear-gradient(135deg, #7C3AED, #6366F1);
  box-shadow: 0 12rpx 28rpx rgba(124, 58, 237, 0.2);
}
.bg-cyan {
  background: linear-gradient(135deg, #0891B2, #06B6D4);
  box-shadow: 0 12rpx 28rpx rgba(8, 145, 178, 0.2);
}
.bg-green {
  background: linear-gradient(135deg, #059669, #10B981);
  box-shadow: 0 12rpx 28rpx rgba(5, 150, 105, 0.2);
}
.bg-orange {
  background: linear-gradient(135deg, #D97706, #F59E0B);
  box-shadow: 0 12rpx 28rpx rgba(217, 119, 6, 0.2);
}

.metric-header {
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.metric-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.metric-icon {
  font-size: 36rpx;
}

.metric-value {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  letter-spacing: 1rpx;
}

.metric-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
  display: block;
}

/* Card titles */
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 28rpx;
  position: relative;
  padding-left: 24rpx;
  letter-spacing: 1rpx;
}

.card-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  background-color: var(--primary);
  border-radius: 4rpx;
}

/* Quick Actions layout */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  text-align: center;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border: 1rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
}

.action-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.bg-primary-light {
  background-color: rgba(124, 58, 237, 0.08);
  border-color: rgba(124, 58, 237, 0.15) !important;
  color: var(--primary);
}
.bg-success-light {
  background-color: rgba(5, 150, 105, 0.08);
  border-color: rgba(5, 150, 105, 0.15) !important;
  color: var(--success);
}
.bg-accent-light {
  background-color: rgba(8, 145, 178, 0.08);
  border-color: rgba(8, 145, 178, 0.15) !important;
  color: var(--accent);
}
.bg-danger-light {
  background-color: rgba(220, 38, 38, 0.08);
  border-color: rgba(220, 38, 38, 0.15) !important;
  color: var(--danger);
}

/* Health Gauge */
.health-gauge {
  padding: 16rpx 0;
  justify-content: space-around;
}

.gauge-center {
  align-items: center;
  justify-content: center;
  border: 12rpx solid rgba(124, 58, 237, 0.08);
  border-top-color: var(--primary);
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.gauge-percent {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.gauge-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.gauge-legend {
  justify-content: center;
}

.legend-row {
  margin-bottom: 16rpx;
}

.legend-indicator {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
}

.legend-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* Category progress bars */
.category-bar-row {
  margin-bottom: 28rpx;
}

.bar-info {
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bar-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.bar-val {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-main);
}

.bar-track {
  height: 14rpx;
  background-color: #E2E8F0;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--primary), var(--accent));
}

.bar-percentage {
  font-size: 20rpx;
  color: var(--text-muted);
  align-self: flex-end;
  margin-top: 8rpx;
}

.empty-state-small {
  padding: 40rpx;
  text-align: center;
}
