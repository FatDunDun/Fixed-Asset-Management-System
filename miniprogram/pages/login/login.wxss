/* pages/login/login.wxss */

.container {
  padding: 48rpx;
  position: relative;
  overflow: hidden;
  justify-content: center;
}

.login-bg-glow {
  position: absolute;
  top: -150rpx;
  right: -150rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.08) 0%, rgba(248, 250, 252, 0) 70%);
  z-index: 0;
  pointer-events: none;
}

.auth-header {
  margin-bottom: 60rpx;
  text-align: center;
  z-index: 1;
}

.brand-logo {
  justify-content: center;
  margin-bottom: 24rpx;
  align-items: center;
}

.logo-img {
  width: 140rpx;
  height: 70rpx;
  margin-right: 20rpx;
  mix-blend-mode: multiply;
}

@keyframes pulse-glow {
  0%, 100% { transform: scale(0.95); box-shadow: 0 0 12rpx rgba(124, 58, 237, 0.3); }
  50% { transform: scale(1.05); box-shadow: 0 0 20rpx rgba(124, 58, 237, 0.6); }
}

.brand-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.system-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.system-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

.auth-card {
  z-index: 1;
  padding: 56rpx 44rpx;
}

.bind-alert {
  background-color: var(--primary-glow);
  border: 1rpx solid rgba(124, 58, 237, 0.15);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.bind-alert-text {
  font-size: 24rpx;
  color: var(--primary);
  margin-left: 16rpx;
  line-height: 36rpx;
  font-weight: 500;
}

.divider-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 44rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: var(--border-glass);
}

.divider-text {
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 0 24rpx;
}

.btn-wechat {
  background: linear-gradient(135deg, #07C160, #05A04F);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.auth-footer {
  justify-content: center;
  margin-top: 44rpx;
}

.footer-link {
  font-size: 26rpx;
  color: var(--primary);
  text-decoration: underline;
}
