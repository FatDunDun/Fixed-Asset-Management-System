/* pages/assets/assets.wxss */

.search-header {
  padding: 16rpx 0;
  margin-bottom: 24rpx;
  z-index: 1;
}

.search-box {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  height: 88rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid var(--border-glass);
}

.search-icon {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-main);
  height: 100%;
}

.clear-icon {
  padding: 10rpx;
  display: flex;
  align-items: center;
}

.btn-search {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  padding: 0 40rpx;
  background: linear-gradient(135deg, var(--primary) 0%, #6D28D9 100%);
  color: #ffffff;
  margin-left: 16rpx;
  border: none;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.25);
}

/* Horizontal scrolling tags */
.filter-section {
  margin-bottom: 28rpx;
  z-index: 1;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding: 4rpx 0;
}

.filter-tag {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background-color: #FFFFFF;
  color: var(--text-secondary);
  border: 1rpx solid var(--border-glass);
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
  transition: all 0.2s ease;
  font-weight: 500;
}

.filter-tag.active {
  background: linear-gradient(135deg, var(--primary) 0%, #6D28D9 100%);
  color: #ffffff;
  border-color: var(--primary);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.25);
}

/* Sorting bar styling */
.sort-bar {
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid var(--border-glass);
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  z-index: 1;
}

.sort-title {
  margin-right: 16rpx;
  font-weight: 500;
}

.sort-picker {
  background-color: #FFFFFF;
  border: 1rpx solid var(--border-glass);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  margin-right: auto;
  color: var(--text-main);
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.01);
}

.sort-picker .arrow {
  font-size: 16rpx;
  margin-left: 10rpx;
  color: var(--text-muted);
}

.sort-order {
  padding: 8rpx 20rpx;
  background-color: #FFFFFF;
  border: 1rpx solid var(--border-glass);
  border-radius: 12rpx;
  color: var(--text-main);
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.01);
}

.order-text {
  margin-right: 8rpx;
}

/* Asset rows styling */
.asset-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.asset-img-container {
  width: 170rpx;
  height: 170rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: #F8FAFC;
  border: 1rpx solid var(--border-glass);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.asset-thumb {
  width: 100%;
  height: 100%;
}

.asset-info {
  overflow: hidden;
  height: 170rpx;
  justify-content: space-between;
}

.asset-header-row {
  justify-content: space-between;
  align-items: center;
}

.asset-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 280rpx;
}

.asset-code {
  font-size: 22rpx;
  color: var(--text-muted);
  margin: 2rpx 0;
}

.asset-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.asset-dept {
  margin-right: 20rpx;
}

.asset-footer-row {
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 4rpx;
}

.asset-price {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--danger);
}

.asset-date {
  font-size: 20rpx;
  color: var(--text-muted);
}

.loading-more, .end-indicator {
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 36rpx 0;
  z-index: 1;
}
