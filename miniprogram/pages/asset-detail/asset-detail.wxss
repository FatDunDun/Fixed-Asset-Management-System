/* pages/asset-detail/asset-detail.wxss */

.swiper-container {
  padding: 0;
  overflow: hidden;
  height: 400rpx;
  background-color: #F8FAFC;
  border: 1rpx solid var(--border-glass);
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.empty-image {
  width: 100%;
  height: 100%;
  background-color: #F8FAFC;
}

.empty-image-icon {
  font-size: 90rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-image-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* Detail Card */
.detail-card {
  padding: 40rpx;
}

.detail-header {
  justify-content: space-between;
  align-items: center;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 48rpx;
  max-width: 440rpx;
}

.price-row {
  margin-top: 20rpx;
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

.price-symbol {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger);
  margin-right: 6rpx;
  line-height: 40rpx;
}

.price-val {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--danger);
  line-height: 52rpx;
}

/* Details Grid */
.details-grid {
  border-top: 1rpx solid var(--border-glass);
}

.grid-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  font-size: 26rpx;
  align-items: center;
}

.grid-label {
  width: 180rpx;
  color: var(--text-secondary);
  font-weight: 500;
  flex-shrink: 0;
}

.grid-value {
  color: var(--text-main);
  font-weight: 600;
}

.code-textSelectable {
  font-family: monospace;
  letter-spacing: 1rpx;
}

.btn-copy {
  font-size: 22rpx;
  color: var(--primary);
  background-color: var(--primary-glow);
  border: 1rpx solid rgba(124, 58, 237, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
}

.grid-desc {
  color: var(--text-secondary);
  line-height: 38rpx;
  font-size: 26rpx;
  background-color: #F8FAFC;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-glass);
  margin-top: 12rpx;
  width: 100%;
}

/* Timeline/History */
.timeline-list {
  padding-top: 20rpx;
}

.timeline-item {
  margin-bottom: 12rpx;
  align-items: stretch;
}

.timeline-left {
  width: 44rpx;
  align-items: center;
  position: relative;
}

.timeline-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  z-index: 2;
  margin-top: 14rpx;
  border: 4rpx solid #FFFFFF;
}

.timeline-line {
  position: absolute;
  top: 36rpx;
  bottom: -24rpx;
  width: 2rpx;
  background-color: var(--border-glass);
  z-index: 1;
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-right {
  padding-left: 24rpx;
  padding-bottom: 36rpx;
}

.timeline-header {
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.timeline-action {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.timeline-time {
  font-size: 20rpx;
  color: var(--text-muted);
}

.timeline-operator {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.timeline-details {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  background-color: #F8FAFC;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  margin-top: 8rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.03);
}

/* Status colors for dots */
.bg-create {
  background-color: var(--success);
  box-shadow: 0 0 12rpx rgba(5, 150, 105, 0.3);
}
.bg-update {
  background-color: var(--primary);
  box-shadow: 0 0 12rpx rgba(124, 58, 237, 0.3);
}
.bg-delete {
  background-color: var(--danger);
  box-shadow: 0 0 12rpx rgba(220, 38, 38, 0.3);
}

/* Action Footer */
.action-footer {
  margin-top: 24rpx;
  margin-bottom: 60rpx;
  z-index: 1;
}

.scrapped-alert {
  background-color: var(--danger-glow);
  border: 1rpx solid rgba(220, 38, 38, 0.15);
  padding: 28rpx;
  margin-bottom: 60rpx;
}

.scrapped-alert-text {
  font-size: 24rpx;
  color: var(--danger);
  line-height: 38rpx;
  font-weight: 600;
}
