<!-- pages/approvals/approvals.wxml -->
<view class="container">
  <!-- Tabs Navigation Header -->
  <view class="tabs-bar card flex-row">
    <!-- Admin Tabs -->
    <block wx:if="{{isAdmin}}">
      <view class="tab-item {{activeTab === 'assets' ? 'active' : ''}}" bindtap="onTabSelect" data-tab="assets">
        <text>资产变动</text>
        <view class="badge badge-tab bg-danger" wx:if="{{pendingAssetsCount > 0}}">{{pendingAssetsCount}}</view>
      </view>
      <view class="tab-item {{activeTab === 'users' ? 'active' : ''}}" bindtap="onTabSelect" data-tab="users">
        <text>用户注册</text>
        <view class="badge badge-tab bg-danger" wx:if="{{pendingUsersCount > 0}}">{{pendingUsersCount}}</view>
      </view>
      <view class="tab-item {{activeTab === 'history' ? 'active' : ''}}" bindtap="onTabSelect" data-tab="history">
        <text>审批历史</text>
      </view>
    </block>
    
    <!-- User Tabs -->
    <block wx:else>
      <view class="tab-item active" style="flex: 1; text-align: center;">
        <text>我的申请流转进度</text>
      </view>
    </block>
  </view>

  <!-- CONTENT PANELS -->

  <!-- 1. Admin Asset Approvals Tab -->
  <view class="panel-content" wx:if="{{isAdmin && activeTab === 'assets'}}">
    <view wx:for="{{assetApprovals}}" wx:key="id" class="card approval-card">
      <view class="card-header flex-row">
        <text class="badge badge-cat">{{item.actionText}}</text>
        <text class="time-text">{{item.created_at}}</text>
      </view>
      
      <view class="card-body">
        <view class="info-row"><text class="info-label">申请人:</text><text class="info-val">{{item.requester}}</text></view>
        <view class="info-row" wx:if="{{item.asset_id}}"><text class="info-label">资产ID:</text><text class="info-val font-mono">{{item.asset_id}}</text></view>
        <view class="info-row" wx:if="{{item.proposed.asset_code}}"><text class="info-label">资产编码:</text><text class="info-val font-mono">{{item.proposed.asset_code}}</text></view>
        <view class="info-row"><text class="info-label">资产名称:</text><text class="info-val bold">{{item.proposed.name}}</text></view>
        
        <!-- Changes diff display -->
        <view class="diff-box" wx:if="{{item.action_type === 'update'}}">
          <text class="diff-title">变更详情:</text>
          <view wx:for="{{item.diffs}}" wx:key="field" class="diff-line flex-row">
            <text class="diff-field">{{item.label}}:</text>
            <text class="diff-old">{{item.oldVal}}</text>
            <text class="diff-arrow">➔</text>
            <text class="diff-new">{{item.newVal}}</text>
          </view>
        </view>

        <view class="diff-box" wx:if="{{item.action_type === 'create'}}">
          <text class="diff-title">入账详情:</text>
          <view class="info-row"><text class="info-label">类别:</text><text class="info-val">{{item.categoryText}}</text></view>
          <view class="info-row"><text class="info-label">单价:</text><text class="info-val">¥{{item.proposed.price}}</text></view>
          <view class="info-row"><text class="info-label">部门:</text><text class="info-val">{{item.proposed.department}}</text></view>
          <view class="info-row"><text class="info-label">保管人:</text><text class="info-val">{{item.proposed.user_name || '无'}}</text></view>
        </view>
      </view>

      <view class="card-footer flex-row">
        <button class="btn btn-secondary flex-1" bindtap="onReviewAsset" data-id="{{item.id}}" data-action="reject">拒绝</button>
        <button class="btn btn-primary flex-1" bindtap="onReviewAsset" data-id="{{item.id}}" data-action="approve" style="margin-left: 20rpx;">同意</button>
      </view>
    </view>

    <!-- Empty state -->
    <view wx:if="{{assetApprovals.length === 0}}" class="empty-state">
      <text class="empty-icon">✓</text>
      <text class="empty-title">资产变动审批已清空</text>
      <text class="empty-desc">当前没有待审批的固定资产登记、修改或报废申请。</text>
    </view>
  </view>

  <!-- 2. Admin User Registration Approvals Tab -->
  <view class="panel-content" wx:if="{{isAdmin && activeTab === 'users'}}">
    <view wx:for="{{userApprovals}}" wx:key="id" class="card approval-card">
      <view class="card-header flex-row">
        <text class="badge badge-success">注册申请</text>
        <text class="time-text">{{item.created_at}}</text>
      </view>
      
      <view class="card-body">
        <view class="info-row"><text class="info-label">用户名:</text><text class="info-val bold">{{item.username}}</text></view>
        <view class="info-row"><text class="info-label">真实姓名:</text><text class="info-val">{{item.real_name}}</text></view>
        <view class="info-row"><text class="info-label">联系电话:</text><text class="info-val">{{item.phone}}</text></view>
        <view class="info-row"><text class="info-label">身份证号:</text><text class="info-val font-mono">{{item.id_card}}</text></view>
        <view class="info-row"><text class="info-label">所属部门:</text><text class="info-val">{{item.department}}</text></view>
      </view>

      <view class="card-footer flex-row">
        <button class="btn btn-secondary flex-1" bindtap="onReviewUser" data-username="{{item.username}}" data-action="reject">拒绝</button>
        <button class="btn btn-primary flex-1" bindtap="onReviewUser" data-username="{{item.username}}" data-action="approve" style="margin-left: 20rpx;">同意</button>
      </view>
    </view>

    <!-- Empty state -->
    <view wx:if="{{userApprovals.length === 0}}" class="empty-state">
      <text class="empty-icon">✓</text>
      <text class="empty-title">注册申请审批已清空</text>
      <text class="empty-desc">当前没有待审批的员工注册请求。</text>
    </view>
  </view>

  <!-- 3. Admin Completed Approvals History Tab -->
  <view class="panel-content" wx:if="{{isAdmin && activeTab === 'history'}}">
    <view wx:for="{{historyApprovals}}" wx:key="id" class="card history-card flex-col">
      <view class="history-header flex-row">
        <text class="badge badge-{{item.typeClass}}">{{item.typeText}}</text>
        <text class="badge badge-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      
      <view class="history-body">
        <view class="info-row"><text class="info-label">申请人:</text><text class="info-val">{{item.requester}}</text></view>
        <view class="info-row"><text class="info-label">决议人:</text><text class="info-val">{{item.reviewer || '系统'}}</text></view>
        <view class="info-row"><text class="info-label">决议时间:</text><text class="info-val">{{item.reviewed_at}}</text></view>
        <view class="info-row" style="align-items: flex-start;">
          <text class="info-label">审核意见:</text>
          <text class="info-val review-notes">{{item.review_notes || '无批注意见。'}}</text>
        </view>
      </view>
    </view>

    <!-- Empty state -->
    <view wx:if="{{historyApprovals.length === 0}}" class="empty-state">
      <text class="empty-icon">📁</text>
      <text class="empty-title">暂无审批决议历史</text>
      <text class="empty-desc">此处将记录您处理过的所有变动及注册审核记录。</text>
    </view>
  </view>

  <!-- 4. Regular User Personal Applications List Tab -->
  <view class="panel-content" wx:if="{{!isAdmin}}">
    <view wx:for="{{userApplications}}" wx:key="id" class="card history-card flex-col">
      <view class="history-header flex-row">
        <text class="badge badge-cat">{{item.typeText}}</text>
        <text class="badge badge-{{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view class="history-body">
        <view class="info-row" wx:if="{{item.asset_code}}"><text class="info-label">资产编码:</text><text class="info-val font-mono">{{item.asset_code}}</text></view>
        <view class="info-row"><text class="info-label">资产名称:</text><text class="info-val bold">{{item.assetName}}</text></view>
        <view class="info-row"><text class="info-label">申请时间:</text><text class="info-val">{{item.created_at}}</text></view>
        <view class="info-row" wx:if="{{item.reviewer}}"><text class="info-label">审批人:</text><text class="info-val">{{item.reviewer}}</text></view>
        <view class="info-row" wx:if="{{item.reviewed_at}}"><text class="info-label">审批时间:</text><text class="info-val">{{item.reviewed_at}}</text></view>
        <view class="info-row" style="align-items: flex-start;" wx:if="{{item.review_notes}}">
          <text class="info-label">审核意见:</text>
          <text class="info-val review-notes">{{item.review_notes}}</text>
        </view>
      </view>
    </view>

    <!-- Empty state -->
    <view wx:if="{{userApplications.length === 0}}" class="empty-state">
      <text class="empty-icon">📁</text>
      <text class="empty-title">暂无申请记录</text>
      <text class="empty-desc">您提交的所有固定资产登记、变更、报废申请将在此显示审批进度。</text>
    </view>
  </view>

  <!-- Review Comment Dialog Popup Modal -->
  <view class="comment-modal flex-center" wx:if="{{showCommentModal}}">
    <view class="modal-content card animate-pop">
      <view class="modal-title">审批批注意见</view>
      <view class="modal-desc">您可以为本次【{{reviewAction === 'approve' ? '同意' : '拒绝'}}】输入批注意见：</view>
      <textarea class="form-textarea" placeholder="在此输入批注（选填）..." bindinput="onCommentInput" value="{{reviewComment}}" cursor-spacing="80"></textarea>
      <view class="modal-buttons flex-row">
        <button class="btn btn-secondary flex-1" bindtap="onCancelReview">取消</button>
        <button class="btn btn-primary flex-1" bindtap="onConfirmReview" style="margin-left: 20rpx;">确认提交</button>
      </view>
    </view>
  </view>
</view>
