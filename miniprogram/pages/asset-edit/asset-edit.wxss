/* pages/asset-edit/asset-edit.wxss */

.form-card {
  padding: 48rpx 36rpx;
  z-index: 1;
}

.form-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.form-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-bottom: 44rpx;
}

.label-hint {
  font-size: 20rpx;
  font-weight: normal;
  color: var(--text-muted);
  margin-left: 8rpx;
}

.form-textarea {
  width: 100%;
  background-color: var(--bg-glass-input);
  border: 1rpx solid var(--border-glass);
  border-radius: var(--radius-md);
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.form-textarea:focus {
  border-color: var(--primary);
  background-color: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.12);
}

/* Image grid uploader */
.image-uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.uploader-img-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  border: 1rpx solid var(--border-glass);
}

.uploader-img {
  width: 100%;
  height: 100%;
}

.btn-remove-img {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: var(--danger);
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: bold;
  z-index: 10;
  box-shadow: 0 4rpx 10rpx rgba(220, 38, 38, 0.3);
}

.uploader-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed rgba(15, 23, 42, 0.15);
  border-radius: var(--radius-md);
  background-color: var(--bg-glass-input);
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.uploader-btn:active {
  background-color: #FFFFFF;
  border-color: var(--primary);
}

.uploader-btn-icon {
  font-size: 48rpx;
  color: var(--text-secondary);
  font-weight: 300;
  line-height: 48rpx;
}

.uploader-btn-text {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}
